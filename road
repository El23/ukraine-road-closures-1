<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Перекрытие дорог в городах Украины</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f4f6f9;
        }
        h1 { text-align: center; color: #333; }
        .search-box {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            box-sizing: border-box;
            font-size: 16px;
        }
        .city-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }
        .btn-city {
            padding: 8px 15px;
            background-color: #0057b7;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-city:hover { background-color: #003f88; }
        .info-card {
            background: white;
            padding: 20px;
            border-radius: 6px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .source-link {
            display: inline-block;
            margin-top: 10px;
            color: #ffd700;
            background: #222;
            padding: 6px 12px;
            text-decoration: none;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <h1>Состояние проезда и перекрытия дорог</h1>
    
    <!-- Поле быстрого поиска города -->
    <input type="text" id="searchInput" class="search-box" placeholder="Поиск города..." onkeyup="filterCities()">

    <!-- Контейнер для кнопок -->
    <div class="city-buttons" id="cityButtons"></div>

    <!-- Блок отображения информации -->
    <div class="info-card" id="infoCard">
        Выберите город из списка выше, чтобы увидеть актуальную информацию.
    </div>

    <script>
        // БАЗА ДАННЫХ ГОРОДОВ И ИСТОЧНИКОВ
        const citiesData = {
            "Киев": {
                info: "Информация о текущих ремонтных работах, ограничениях движения и перекрытиях в Киеве.",
                source: "https://kiev.depo.ua/"
            },
            "Харьков": {
                info: "Данные об изменениях в движении транспорта и перекрытиях улиц Харькова.",
                source: "https://t.me/patrolpolice_kharkiv"
            },
            "Одесса": {
                info: "Информация о ремонте дорог и перекрытиях движения в Одессе.",
                source: "https://t.me/patrolpolice_odesa"
            },
            "Днепр": {
                info: "Официальные уведомления о состоянии дорог и перекрытиях в Днепре.",
                source: "https://t.me/patrolpolice_dnipro"
            },
            "Львов": {
                info: "Оперативные данные по перекрытию улиц во Львове.",
                source: "https://t.me/patrolpolice_lviv"
            }
        };

        const cityButtonsContainer = document.getElementById('cityButtons');
        const infoCard = document.getElementById('infoCard');

        // Функция генерации кнопок
        function renderButtons() {
            cityButtonsContainer.innerHTML = '';
            Object.keys(citiesData).forEach(cityName => {
                const button = document.createElement('button');
                button.className = 'btn-city';
                button.innerText = cityName;
                button.onclick = () => showInfo(cityName);
                cityButtonsContainer.appendChild(button);
            });
        }

        // Функция показа информации по клику
        function showInfo(cityName) {
            const data = citiesData[cityName];
            infoCard.innerHTML = `
                <h2>${cityName}</h2>
                <p>${data.info}</p>
                <a class="source-link" href="${data.source}" target="_blank">Официальный источник информации ↗</a>
            `;
        }

        // Фильтрация кнопок при поиске
        function filterCities() {
            const filter = document.getElementById('searchInput').value.toLowerCase();
            const buttons = cityButtonsContainer.getElementsByClassName('btn-city');
            Array.from(buttons).forEach(button => {
                const text = button.innerText.toLowerCase();
                button.style.display = text.includes(filter) ? "" : "none";
            });
        }

        // Инициализация при загрузке
        renderButtons();
    </script>
</body>
</html>
